{
	"schemaVersion": 1,
	"id": "nyxum",
	"version": "${version}",
	"name": "Nyxum",
	"description": "Adds a data-driven system to implement powers and abilities into Minecraft.",
	"authors": [
		"nuxlox"
	],
	"contact": {
	},
	"license": "MIT",
	"icon": "assets/nyxum/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "nux.nyxum.Nyxum",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "nux.nyxum.client.NyxumClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"nyxum.mixins.json",
		{
			"config": "nyxum.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}